{
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/js": "9.38.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.7.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "husky": "^8.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "json-server": "^0.17.4",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.1.11",
    "vite-plugin-istanbul": "^7.2.1"
  },
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev:client": "vite",
    "build:client": "vite build",
    "preview:client": "vite preview",
    "server:mock": "json-server --watch db.json --port 3002",
    "start:server": "npm run dev --prefix backend",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run start:server\"",
    "dev": "npm run dev:all",
    "test:component": "cross-env NODE_ENV=test cypress run --component",
    "test:component:open": "cross-env NODE_ENV=test cypress open --component",
    "coverage:report": "npm run test:component && nyc report --reporter=html"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react-router-dom": "^7.9.5"
  }
}
